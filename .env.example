# Production environment variables for Docker Compose
# Copy this file to .env and fill in the values

# Database
DB_ROOT_PASSWORD=changeme_root
DB_PASSWORD=changeme_bookstudio

# Public port for the app
PUBLIC_PORT=80

# AI provider: ollama | gemini | anythingllm
AI_PROVIDER=ollama

# Ollama – running on the host machine
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# AnythingLLM – optional
ANYTHINGLLM_URL=http://host.docker.internal:3001
ANYTHINGLLM_API_KEY=

# Gemini – optional cloud fallback
GEMINI_API_KEY=

# Kokoro TTS – running on the host machine
KOKORO_URL=http://host.docker.internal:8880
