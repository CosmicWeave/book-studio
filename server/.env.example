# Server Environment Variables

# Database
DATABASE_URL="mysql://bookstudio:bookstudio@localhost:3306/bookstudio"

# Server
PORT=3001
HOST=0.0.0.0

# File storage (absolute path)
FILES_DIR=./data/files

# AI - Active provider: ollama | gemini | anythingllm
AI_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# AnythingLLM
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=

# Gemini (optional cloud fallback)
GEMINI_API_KEY=

# Kokoro TTS (local)
KOKORO_URL=http://localhost:8880
# If Kokoro runs as a CLI, set the path to the executable instead:
# KOKORO_CLI_PATH=/path/to/kokoro

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
